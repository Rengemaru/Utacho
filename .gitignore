# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# Google Play サービスアカウントキー（秘密鍵のため必ずignore）
google-services-key.json

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# ビルド成果物（AAB / APK・リポジトリ肥大化防止のためignore）
*.aab
*.apk

# アイコンビルド中間ファイル・デザイン検討用素材
assets/icon-build-*.svg
assets/icon-build-*.svg.png
assets/icon-concepts/

# ドキュメント（ローカル管理）
docs/instructions/
docs/reports/
